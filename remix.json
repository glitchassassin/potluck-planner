{
  "$schema": "./node_modules/remix/schema/remix.json",
  "db": {
    "adapter": {
      "type": "sqlite",
      "filename": {
        "env": "DATABASE_PATH",
        "default": "./db/app.sqlite"
      },
      "foreignKeys": true,
      "busyTimeout": 5000
    },
    "migrations": {
      "directory": "./db/migrations"
    }
  },
  "test": {
    "files": ["app/**/*.test.{ts,tsx}"]
  }
}
