PORT=44100
DATABASE_PATH=./db/app.sqlite

# Comma-separated US and territory phone numbers granted Admin access after verification
ADMIN_PHONE_ALLOWLIST=

# Logging: debug, info, warn, error, silent
LOG_LEVEL=info
# Request logs: off, summary, detailed (includes named operation durations)
REQUEST_LOG_DETAIL=summary
# Browser-visible timing headers: off, summary, detailed
SERVER_TIMING=off
